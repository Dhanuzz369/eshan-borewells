# Set this to the public production URL if Vercel's production URL is not suitable.
NEXT_PUBLIC_SITE_URL=https://www.eshanborewells.com

# Optional: when configured, footer and popup enquiries are POSTed to this HTTPS endpoint.
# Without it, visitors are directed to a prefilled WhatsApp chat instead.
LEADS_WEBHOOK_URL=
# Optional bearer token sent to the lead destination. Never expose this as NEXT_PUBLIC_...
LEADS_WEBHOOK_TOKEN=

# V2 quote flow: private server-only values. See docs/QUOTE-SETUP.md.
# Use a durable Upstash Redis database (REST endpoint and restricted token).
QUOTE_REDIS_REST_URL=
QUOTE_REDIS_REST_TOKEN=
# Authorizes GET /api/quotes/retry from a scheduler, never from a browser.
QUOTE_RETRY_SECRET=
